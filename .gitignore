# Python
__pycache__/
*.py[cod]
.Python
build/
dist/
*.egg-info/
.venv/
venv/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local working notes — never committed (see workspace CLAUDE.md)
.local/

# The pytest example resolves vendorfake from the checkout by path, so its
# lockfile is machine-specific; node_modules is never committed anywhere.
examples/*/uv.lock
examples/*/node_modules/

# A non-vendored vendor's spec extract is cut at run time into the cache and
# must never enter the repository (roadmap#56); belt to the wheel check's braces.
src/vendorfake/toast/fidelity/extract.json
src/vendorfake/*/fidelity/DRIFT
