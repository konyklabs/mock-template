{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://konyklabs.github.io/vendorfake/fidelity/corpus.schema.json",
  "title": "vendorfake fidelity corpus case, format 1",
  "description": "One documented request/response fact about a vendor API, with the page it was read from.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "title",
    "source",
    "steps"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]*$",
      "description": "Unique within one vendor's corpus."
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "routes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z]+ /"
      },
      "description": "Route keys, in the unit's spelling, the case claims to cover. Optional: coverage is attributed to the routes the steps actually reach; a listed route no step reaches fails the case."
    },
    "profile": {
      "type": "string",
      "minLength": 1
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "fetched",
        "provenance"
      ],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https?://",
          "description": "The page the fact was read from. A judgment cites the page that is silent; a recording cites the page it is evidence about, or the API reference root."
        },
        "fetched": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "provenance": {
          "enum": [
            "documented",
            "judgment",
            "recorded"
          ]
        },
        "note": {
          "type": "string"
        },
        "environment": {
          "enum": [
            "sandbox",
            "production"
          ],
          "description": "Which account the traffic was recorded against."
        },
        "api_version": {
          "type": "string",
          "minLength": 1,
          "description": "The API version the recorded exchange was made under."
        },
        "recorded": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "The day the exchange happened, which is not the day the page was fetched."
        },
        "script": {
          "type": "string",
          "minLength": 1,
          "description": "What produced the recording, so it can be produced again."
        },
        "redaction": {
          "type": "string",
          "minLength": 1,
          "description": "What was replaced by ${any}, ${re:...} or ${vars.*} before the case was committed."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "provenance": {
                "const": "recorded"
              }
            },
            "required": [
              "provenance"
            ]
          },
          "then": {
            "required": [
              "environment",
              "api_version",
              "recorded",
              "script",
              "redaction"
            ]
          }
        }
      ]
    },
    "stringMap": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "pointer": {
      "type": "string",
      "pattern": "^(/([^/~]|~[01])*)*$",
      "description": "An RFC 6901 JSON pointer into the response body."
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "request",
        "expect"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "request": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "path"
          ],
          "properties": {
            "method": {
              "enum": [
                "GET",
                "PUT",
                "POST",
                "DELETE",
                "OPTIONS",
                "HEAD",
                "PATCH",
                "TRACE"
              ]
            },
            "path": {
              "type": "string",
              "pattern": "^/"
            },
            "headers": {
              "$ref": "#/$defs/stringMap"
            },
            "query": {
              "$ref": "#/$defs/stringMap"
            },
            "body": {}
          }
        },
        "expect": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "type": "integer",
              "minimum": 100,
              "maximum": 599
            },
            "headers": {
              "$ref": "#/$defs/stringMap"
            },
            "body": {},
            "absent": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/pointer"
              }
            }
          }
        },
        "capture": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/pointer"
          }
        }
      }
    }
  }
}
