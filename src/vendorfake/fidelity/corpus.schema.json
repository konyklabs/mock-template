{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://konyklabs.github.io/vendorfake/fidelity/corpus.schema.json",
  "title": "vendorfake fidelity corpus case, format 1",
  "description": "One documented request/response fact about a vendor API, with the page it was read from.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "title", "source", "routes", "steps"],
  "properties": {
    "schema": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]*$",
      "description": "Unique within one vendor's corpus."
    },
    "title": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "fetched", "provenance"],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https?://",
          "description": "The page the fact was read from. A judgment cites the page that is silent."
        },
        "fetched": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "provenance": { "enum": ["documented", "judgment"] },
        "note": { "type": "string" }
      }
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Z]+ /" },
      "description": "Route keys in the unit's spelling, for the matrix."
    },
    "profile": { "type": "string", "minLength": 1 },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/step" }
    }
  },
  "$defs": {
    "stringMap": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "pointer": {
      "type": "string",
      "pattern": "^(/([^/~]|~[01])*)*$",
      "description": "An RFC 6901 JSON pointer into the response body."
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "request", "expect"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "request": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "path"],
          "properties": {
            "method": { "enum": ["GET", "PUT", "POST", "DELETE", "OPTIONS", "HEAD", "PATCH", "TRACE"] },
            "path": { "type": "string", "pattern": "^/" },
            "headers": { "$ref": "#/$defs/stringMap" },
            "query": { "$ref": "#/$defs/stringMap" },
            "body": {}
          }
        },
        "expect": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": { "type": "integer", "minimum": 100, "maximum": 599 },
            "headers": { "$ref": "#/$defs/stringMap" },
            "body": {},
            "absent": {
              "type": "array",
              "items": { "$ref": "#/$defs/pointer" }
            }
          }
        },
        "capture": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/pointer" }
        }
      }
    }
  }
}
