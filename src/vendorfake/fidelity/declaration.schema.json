{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://konyklabs.github.io/vendorfake/fidelity/declaration.schema.json",
  "title": "vendorfake fidelity declaration v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "sources"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "url"
        ],
        "properties": {
          "kind": {
            "enum": [
              "openapi3",
              "swagger2",
              "fragments"
            ]
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "base_path": {
            "type": "string"
          }
        }
      }
    },
    "error_envelope": {
      "type": "string",
      "pattern": "^[1-5][0-9][0-9]$"
    },
    "error_member": {
      "type": "string",
      "minLength": 1
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "method",
          "path",
          "spec_path",
          "reason"
        ],
        "properties": {
          "method": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "spec_path": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "excused": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "method",
          "path",
          "reason"
        ],
        "properties": {
          "method": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "deviations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pointer",
          "keyword",
          "value",
          "reason",
          "url"
        ],
        "properties": {
          "pointer": {
            "type": "string",
            "pattern": "^/"
          },
          "keyword": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": [
              "string",
              "number",
              "boolean"
            ],
            "description": "The one instance value excused, in its JSON type."
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "routes": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z]+ /"
            }
          }
        }
      }
    },
    "variables": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "stubs_accepted": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Schema names the extract may stub to {} because upstream dangles there. Every stub in the extract must be listed, or pin --check --offline fails."
    }
  },
  "dependentRequired": {
    "error_envelope": [
      "error_member"
    ]
  }
}
